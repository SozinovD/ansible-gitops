---
# Lives on the device as /etc/ansible-gitops/roles.yml (root-only, chmod 600).
# Roles listed here are appended to extra_roles from
# host_vars/<hostname>.yml (after the repo list, duplicates skipped).

extra_roles:
  - wifi_hotspot

# Roles listed under remove_roles are removed on the next ansible-pull run:
# local.yml executes the role's tasks/remove.yml (containers stop, the compose
# directory is deleted; data volumes and data directories are kept) and skips
# the role if it is also listed in extra_roles. Roles without tasks/remove.yml
# are only skipped with a warning.
# remove_roles:
#   - portainer

# Variables for locally added roles can live here or in secrets.yml:
# wifi_hotspot_interface: mlan0
# wifi_hotspot_ap_ssid: SBC-Hotspot

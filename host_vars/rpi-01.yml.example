---
ansible_pull_interval: 15min

extra_roles:
  - common
  - portainer
  - hermes_agent
  # - pisugar
  # - wifi_hotspot
  # - caddy
  # - authelia
  # - netbird
  # - oauth2_proxy

# common_packages:
#   - vim
#   - tmux
# common_shell_aliases:
#   ll: ls -alF
# common_editor: vim

# pisugar_model: "PiSugar 3"
# pisugar_safe_shutdown_level: 15
# pisugar_safe_shutdown_delay: 60
# pisugar_tap_shells:
#   single: "wall battery low check"    # runs as root, single line
#   double: ""
#   long: "shutdown -h now"

# wifi_hotspot_interface: mlan0
# wifi_hotspot_ap_ssid: SBC-Hotspot
# wifi_hotspot_ap_passphrase: change-me

# authelia_session_domain: example.com
# authelia_access_rules:
#   - domain:
#       - portainer.example.com
#     policy: one_factor

# caddy_sites:
#   - host: portainer.example.com
#     to: host.docker.internal:9443
#     auth: true
#   - host: app.example.com
#     to: host.docker.internal:8080
#     auth: google

# oauth2_proxy_allowed_emails:     # accounts allowed to log in with Google
#   - me@gmail.com
# oauth2_proxy_cookie_domains: [.example.com]        # one login for all sites
# oauth2_proxy_whitelist_domains: [.example.com]

# netbird_management_url: https://netbird.example.com   # self-hosted; empty = cloud

hermes_agent_env:
  HERMES_LOG_LEVEL: info

# Secrets (bot tokens, API keys) live on the device in
# /etc/ansible-gitops/secrets.yml — see README "Secrets". Example:
#   portainer_telegram_bot_token: "123456:ABC-DEF..."
#   portainer_telegram_api_key: "ptr_..."

# Extra roles can also be added locally on the device in
# /etc/ansible-gitops/roles.yml — see README "Local roles".

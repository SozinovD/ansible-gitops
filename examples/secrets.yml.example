---
# Lives on the device as /etc/ansible-gitops/secrets.yml (root-only, chmod 600),
# never in this repo. Variables here override role defaults (see README "Secrets").

# portainer: initial admin password (min 12 chars), created on first run
portainer_admin_password: "change-me-12chars"

# portainer_telegram
portainer_telegram_bot_token: "123456:ABC-DEF..."
portainer_telegram_api_key: "ptr_..."
portainer_telegram_allowed_chat_ids: "123456789"

# wifi_hotspot: AP password is device-local, keep it out of host_vars
wifi_hotspot_ap_passphrase: "change-me"

# netbird: peer setup key from the NetBird dashboard
netbird_setup_key: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# authelia: random secrets, generate each with `openssl rand -hex 32`
authelia_jwt_secret: "change-me"
authelia_session_secret: "change-me"
authelia_storage_encryption_key: "change-me"

# oauth2_proxy: Google OAuth client credentials (see roles/oauth2_proxy/README.md)
oauth2_proxy_client_id: "1234-abc.apps.googleusercontent.com"
oauth2_proxy_client_secret: "GOCSPX-..."
oauth2_proxy_cookie_secret: "change-me"

# common: extra fail2ban ignoreip, e.g. VPN subnet or the git server the
# device pulls this repo from (merged with the role defaults, duplicates dropped)
common_fail2ban_extra_ignoreip:
  - 100.64.0.0/10
  - 203.0.113.10

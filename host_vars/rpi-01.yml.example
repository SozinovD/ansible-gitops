---
ansible_pull_interval: 15min

sbc_extra_roles:
  - portainer
  - hermes_agent

hermes_agent_env:
  HERMES_LOG_LEVEL: info

# Secrets (bot tokens, API keys) live on the device in
# /etc/sbc-tools/secrets.yml — see README "Secrets". Example:
#   portainer_telegram_bot_token: "123456:ABC-DEF..."
#   portainer_telegram_api_key: "ptr_..."

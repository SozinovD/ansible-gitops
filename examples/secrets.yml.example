---
# Lives on the device as /etc/sbc-tools/secrets.yml (root-only, chmod 600),
# never in this repo. Variables here override role defaults (see README "Secrets").

# portainer_telegram
portainer_telegram_bot_token: "123456:ABC-DEF..."
portainer_telegram_api_key: "ptr_..."
portainer_telegram_allowed_chat_ids: "123456789"

# wifi_hotspot: AP password is device-local, keep it out of host_vars
wifi_hotspot_ap_passphrase: "change-me"
